-- Analytic Functions :

-- 1.ROW_NUMBER (Gives a unique serial number):
-- Example :
SELECT student_id, student_name, cgpa,
 ROW_NUMBER() OVER (ORDER BY cgpa DESC) AS row_no
FROM student;

-- 2.RANK ( If there is a tie, the next rank is skipped):
-- Example :
SELECT student_id, student_name, cgpa,
 RANK() OVER (ORDER BY cgpa DESC) AS cgpa_rank
FROM student;

-- 3.DENSE_RANK :
-- Example :
SELECT student_id, student_name, cgpa,
 DENSE_RANK() OVER (ORDER BY cgpa DESC) AS cgpa_rank
FROM student;

-- 1. Example :
Top 3 students
SELECT *
FROM (
 SELECT student_id, student_name, cgpa,
 DENSE_RANK() OVER (ORDER BY cgpa DESC) AS cgpa_rank
 FROM student
)
WHERE cgpa_rank <= 3;
-- 2. Example :

Top student from each department
SELECT *
FROM (
 SELECT s.student_id, s.student_name, d.dept_name, s.cgpa,
 DENSE_RANK() OVER (
 PARTITION BY s.dept_id
 ORDER BY s.cgpa DESC
 ) AS dept_rank
 FROM student s
 JOIN department d
 ON s.dept_id = d.dept_id
)
WHERE dept_rank = 1;
