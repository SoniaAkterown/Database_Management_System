-- Step 1: Create the students table
CREATE TABLE students (
student_id NUMBER PRIMARY KEY,
name VARCHAR2(50),
department VARCHAR2(30),
cgpa NUMBER(3,2)
);

-- Step 2: Insert sample data
INSERT INTO students VALUES (1, 'Amina', 'CSE', 3.80);
INSERT INTO students VALUES (2, 'Rahim', 'EEE', 3.45);
INSERT INTO students VALUES (3, 'Karim', 'CSE', 3.90);

-- Step 3: Create a log table
-- This table will store trigger messages.
CREATE TABLE student_log (
log_id NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
student_id NUMBER,
action_name VARCHAR2(50),
action_time DATE
);

-- Step 4:
CREATE OR REPLACE TRIGGER trg_after_insert_student
AFTER INSERT
ON students
FOR EACH ROW
BEGIN
INSERT INTO student_log (student_id, action_name, action_time)
VALUES (:NEW.student_id, 'INSERT', SYSDATE);
END;
/


-- Test the Trigger
