-- Set Operators (UNION,UNION ALL,INTERSECT,MINUS ) :

-- 1.UNION (Combines  and removes duplicates):
SELECT dept_id FROM student WHERE dept_id IS NOT NULL
UNION
SELECT dept_id FROM department;

--2.UNION ALL (Combines and keeps duplicates) :
SELECT dept_id FROM student WHERE dept_id IS NOT NULL
UNION ALL
SELECT dept_id FROM department;

--3.INTERSECT (exist in both tables):
SELECT dept_id FROM department
INTERSECT
SELECT dept_id FROM student;

--4.MINUS :
SELECT dept_id FROM department
MINUS
SELECT dept_id FROM student;
//Returns department IDs that exist in department but not in student

